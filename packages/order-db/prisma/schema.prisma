generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Order {
    id       String      @id @default(ulid())
    userId   String
    email    String
    amount   String
    status   OrderStatus @default(pending)
    products Json

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model UserAddress {
    id        String  @id @default(ulid())
    userId    String
    name      String
    email     String
    phone     String
    address   String
    city      String
    isDefault Boolean @default(false)

    createdAt DateTime @default(now())

    @@index([userId])
}

enum OrderStatus {
    pending
    success
    failed
}
