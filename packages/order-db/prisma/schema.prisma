generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Order {
    id       String      @id @default(ulid())
    userId   String
    email    String
    amount   String
    status   OrderStatus @default(pending)
    products Json

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum OrderStatus {
    pending
    success
    failed
}
